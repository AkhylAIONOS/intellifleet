# Core application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:4200

# Generate a strong application secret for production. Do not commit its value.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
TOKEN_EXPIRE_TIME_HOURS=24

# Required for AI chat and route-query features
OPENAI_API_KEY=

# Required for Google Maps routing/geocoding features
GOOGLE_MAPS_API_KEY=

# Required for signup verification email
SMTP_SERVER=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Local services/data
REDIS_URL=redis://localhost:6379/0
# The application currently uses the bundled SQLite users.db directly.
DATABASE_URL=sqlite:///users.db

# Present in settings but no active usage was found
GROQ_API_KEY=
GEMINI_API_KEY=
